# Site
NEXT_PUBLIC_SITE_URL=https://globalcodio.ai

# Email (Resend)
RESEND_API_KEY=
# Until domain verified at resend.com/domains, use: GlobalCodio Contact <onboarding@resend.dev>
# After domain verified, change to: GlobalCodio Contact <info@globalcodio.ai>
RESEND_FROM_EMAIL=GlobalCodio Contact <onboarding@resend.dev>
CONTACT_TO_EMAIL=vineeth.kumar@medicodio.ai

# Server
API_PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Sanity - project config (safe to expose, prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-06-01

# Sanity - write token (Editor role, server-side only, NEVER prefix with NEXT_PUBLIC_)
# Get from: https://www.sanity.io/manage → your project → API → Tokens → Add API token
SANITY_API_TOKEN=
